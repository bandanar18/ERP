# =====================================================
# BUSINESS ERP - VARIABLES DE ENTORNO (TEMPLATE)
# Monorepo - Turborepo
# 
# Instrucciones:
# 1. Copiar este archivo a .env en la raíz del monorepo
# 2. Completar con los valores reales de tu entorno
# 3. NUNCA commitear el archivo .env con valores reales
# =====================================================

# -----------------------------------------------------
# DATABASE
# -----------------------------------------------------
# URL de conexión a PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# -----------------------------------------------------
# JWT - AUTENTICACIÓN
# -----------------------------------------------------
# Secret para firmar access tokens (generar uno único y seguro)
JWT_SECRET="your-secret-key-change-this"

# Secret para firmar refresh tokens (diferente al anterior)
JWT_REFRESH_SECRET="your-refresh-secret-key-change-this"

# Tiempo de expiración del access token (ej: 15m, 1h, 30m)
ACCESS_TOKEN_EXPIRY="30m"

# Tiempo de expiración del refresh token (ej: 7d, 1w, 30d)
REFRESH_TOKEN_EXPIRY="7d"

# -----------------------------------------------------
# MÓDULO EJECUTIVO (Seguimiento de Indicadores)
# -----------------------------------------------------
# JWT PROPIO del módulo (independiente del JWT del ERP).
# Obligatorio: el módulo no arranca sin él (fail-fast).
EXECUTIVE_JWT_SECRET="your-executive-secret-key-change-this"
# Expiración del access token del módulo (ej: 8h, 30m)
EXECUTIVE_JWT_EXPIRES_IN="8h"

# -----------------------------------------------------
# REDIS (opcional)
# -----------------------------------------------------
# URL de conexión a Redis. Si no se configura, usa fallback a DB
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------
# EMAIL / SMTP
# -----------------------------------------------------
# Host del servidor SMTP
EMAIL_HOST="smtp.gmail.com"

# Puerto del servidor SMTP (587 para TLS, 465 para SSL)
EMAIL_PORT=587

# Usuario para autenticación SMTP
EMAIL_USER="your-email@example.com"

# Contraseña o App Password para SMTP
EMAIL_PASS="your-email-password"

# Email desde donde se envían los correos
EMAIL_FROM="noreply@example.com"

# -----------------------------------------------------
# APP - GENERAL
# -----------------------------------------------------
# Nombre de la aplicación
APP_NAME="Business ERP"

# URL del frontend (CORS / landing). Si es localhost, los emails de
# reset usan el dominio público de producción automáticamente.
FRONTEND_URL="http://localhost:5173"

# Orígenes públicos para links de email (opcionales; default = producción)
# PM_FRONTEND_URL="https://proyectos.bdgestion.org"
# QC_FRONTEND_URL="https://calidad.bdgestion.org"

# -----------------------------------------------------
# SERVER - BACKEND
# -----------------------------------------------------
# Puerto donde corre el backend
PORT=3000

# Entorno: development | production
NODE_ENV="development"

# -----------------------------------------------------
# FRONTEND - VITE
# -----------------------------------------------------
# URL base de la API del backend (para fetch desde el frontend)
VITE_API_URL="http://localhost:3000"

# -----------------------------------------------------
# UPLOADS
# -----------------------------------------------------
# Directorio raíz de uploads (gallery de PM y file-gallery).
# En Railway: montar un volumen en /app/data y apuntar aquí (persiste entre deploys).
UPLOADS_DIR="uploads"
