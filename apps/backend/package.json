  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "start:tsx": "NODE_ENV=production tsx src/index.ts",
    "start:prod": "pnpm build && prisma generate && prisma migrate deploy && NODE_ENV=production tsx src/index.ts",
    "start:prod:seed": "pnpm build && prisma generate && prisma migrate deploy && prisma db seed && NODE_ENV=production tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "create-feature": "tsx scripts/create-feature.ts",
    "test-email": "tsx scripts/test-email.ts",
    "test-redis": "tsx scripts/test-redis.ts",
    "test-db": "tsx scripts/test-db.ts",
    "railway": "pnpm build && npx prisma generate && npx prisma migrate deploy && pnpm start:tsx",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "tunnel:local": "cloudflared tunnel --url http://localhost:3000 --log-level info",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:seed:init": "tsx prisma/seed/seed-init.ts",
    "db:seed:basic": "prisma db seed",
    "db:seed:pm": "tsx prisma/seed/project-management.ts",
    "db:seed:qc": "tsx prisma/seed/quality-control.ts",
    "db:seed:demo": "tsx prisma/seed/seed-demo.ts",
    "db:seed:payables": "tsx prisma/seed/payables.ts",
    "db:seed:prod": "NODE_ENV=production tsx prisma/seed/seed-production.ts",
    "db:migrate:pm": "tsx scripts/migrate-project-management.ts",
    "db:drop:legacy": "tsx scripts/drop-legacy-tables.ts",
    "db:sync:pm-names": "tsx scripts/sync-pm-user-names.ts",
    "test:pm": "tsx --test src/modules/project-management/tests/*.test.ts",
    "smoke:pm": "tsx scripts/smoke-project-management.ts",
    "db:reset": "prisma migrate reset && prisma db seed"
  },
