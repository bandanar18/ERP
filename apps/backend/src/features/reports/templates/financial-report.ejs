<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Informe de Pagos y Cuentas por Pagar</title>
  <style>
    @page {
      size: A4 portrait;
      margin: 20mm 15mm 20mm 15mm;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #111416;
      background: #ffffff;
      font-size: 9pt;
      line-height: 1.45;
      -webkit-font-smoothing: antialiased;
    }

    .report-container {
      width: 100%;
      max-width: 820px;
      margin: 0 auto;
    }

    /* ── HEADER ────────────────────────────────────────────────────────── */
    .header {
      border-bottom: 1px solid #d8d0c4;
      padding-bottom: 14px;
      margin-bottom: 18px;
    }
    .header-table {
      width: 100%;
      border-collapse: collapse;
    }
    .header-table td {
      vertical-align: top;
    }
    .header-title {
      font-size: 20pt;
      font-weight: 700;
      color: #111416;
      letter-spacing: -0.01em;
      line-height: 1.1;
    }
    .header-subtitle {
      font-size: 8.5pt;
      color: #4e5558;
      margin-top: 4px;
      font-weight: 500;
    }
    .header-meta {
      text-align: right;
    }
    .code-badge {
      display: inline-block;
      font-family: monospace;
      font-size: 8.5pt;
      font-weight: 800;
      letter-spacing: 0.05em;
      background: #111416;
      color: #fffdf9;
      padding: 3px 8px;
      border-radius: 4px;
    }
    .emission-date {
      display: block;
      font-size: 7.5pt;
      color: #8d918f;
      margin-top: 5px;
      font-weight: 600;
    }
    .accent-bar {
      margin-top: 12px;
      height: 3px;
      width: 100%;
      border-radius: 2px;
      background: #111416;
      display: flex;
      overflow: hidden;
    }
    .accent-bar .seg-green  { width: 90px; height: 100%; background: #4c9b7a; }
    .accent-bar .seg-orange { width: 45px; height: 100%; background: #d9772f; }

    /* ── SECCIONES ──────────────────────────────────────────────────────── */
    .section {
      margin-top: 18px;
    }
    .avoid-break {
      page-break-inside: avoid;
      break-inside: avoid;
    }
    .section-header-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 8px;
    }
    .section-title {
      font-size: 8.5pt;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: #111416;
    }
    .section-subtitle {
      text-align: right;
      font-size: 7.5pt;
      font-weight: 600;
      color: #8d918f;
    }
    .pill-badge {
      display: inline-block;
      font-size: 7.5pt;
      font-weight: 700;
      color: #4e5558;
      background: #f5f0e8;
      border: 1px solid #d8d0c4;
      padding: 2px 7px;
      border-radius: 4px;
    }

    /* ── FICHA PROYECTO ─────────────────────────────────────────────────── */
    .ficha-card {
      border: 1px solid #d8d0c4;
      background: #fbf9f5;
      border-radius: 8px;
      padding: 12px 14px;
    }
    .ficha-table {
      width: 100%;
      border-collapse: collapse;
    }
    .ficha-table td {
      vertical-align: top;
    }
    .field-label {
      font-size: 7pt;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #8d918f;
      display: block;
      margin-bottom: 2px;
    }
    .field-value {
      font-size: 9pt;
      font-weight: 700;
      color: #111416;
    }
    .field-value-sm {
      font-size: 8pt;
      font-weight: 600;
      color: #111416;
    }

    /* ── KPI CARDS ──────────────────────────────────────────────────────── */
    .kpi-table {
      width: 100%;
      border-collapse: collapse;
    }
    .kpi-card {
      border-radius: 8px;
      padding: 12px 14px;
    }
    .kpi-card-neutral {
      border: 1px solid #d8d0c4;
      background: #fbf9f5;
    }
    .kpi-card-paid {
      border: 1px solid #a3d4bb;
      background: #f0f7f3;
    }
    .kpi-card-pending-alert {
      border: 1px solid #edb6a5;
      background: #fff0eb;
    }
    .kpi-card-pending-ok {
      border: 1px solid #d8d0c4;
      background: #fbf9f5;
    }
    .kpi-title {
      font-size: 7.5pt;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    .kpi-number {
      font-size: 22pt;
      font-weight: 700;
      line-height: 1;
      margin-top: 4px;
    }
    .kpi-unit {
      font-size: 8pt;
      font-weight: 700;
      margin-left: 4px;
    }
    .kpi-foot {
      font-size: 7pt;
      margin-top: 6px;
      font-weight: 600;
    }

    /* ── BARRA DE PROPORCIÓN DE DEUDA ───────────────────────────────────── */
    .progress-bar-card {
      margin-top: 10px;
      border: 1px solid #d8d0c4;
      background: #fffdf9;
      border-radius: 6px;
      padding: 10px 12px;
    }
    .progress-legend-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 6px;
      font-size: 7.5pt;
      font-weight: 700;
    }
    .progress-track {
      position: relative;
      height: 10px;
      width: 100%;
      background: #ece6dc;
      border-radius: 5px;
      overflow: hidden;
    }
    .progress-fill-paid {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      background: #236343;
    }
    .progress-fill-pending {
      position: absolute;
      top: 0;
      bottom: 0;
      right: 0;
      background: #c85454;
    }

    /* ── TABLA DE CUENTAS POR PAGAR ─────────────────────────────────────── */
    .table-wrapper {
      border: 1px solid #d8d0c4;
      border-radius: 6px;
      overflow: hidden;
      background: #ffffff;
    }
    .report-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      font-size: 8pt;
    }
    .report-table thead th {
      background: #f5f0e8;
      border-bottom: 1px solid #d8d0c4;
      padding: 7px 10px;
      text-align: left;
      font-size: 7pt;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #4e5558;
    }
    .report-table thead th.text-right { text-align: right; }
    .report-table thead th.text-center { text-align: center; }

    .report-table tbody tr {
      border-bottom: 1px solid #ece6dc;
      page-break-inside: avoid;
      break-inside: avoid;
    }
    .report-table tbody tr:nth-child(even) {
      background: #fbf9f5;
    }
    .report-table tbody td {
      padding: 7px 10px;
      vertical-align: middle;
    }

    .badge-status {
      display: inline-block;
      border-radius: 4px;
      padding: 2px 6px;
      font-size: 6.5pt;
      font-weight: 700;
      border: 1px solid transparent;
    }
    .badge-pagado {
      background: #edf3ec;
      color: #376850;
      border-color: #a7c9b4;
    }
    .badge-parcial {
      background: #fdf4dc;
      color: #8a6a12;
      border-color: #e6d28f;
    }
    .badge-pendiente {
      background: #fff0eb;
      color: #a84730;
      border-color: #edb6a5;
    }
  </style>
</head>
<body>
  <div class="report-container">

    <!-- 1. MEMBRETE OFICIAL -->
    <header class="header avoid-break">
      <table class="header-table">
        <tr>
          <td style="width: 70%;">
            <h1 class="header-title">INFORME DE PAGOS Y CUENTAS POR PAGAR</h1>
            <p class="header-subtitle">
              <% if (isProjectMode && project) { %>
                Proyecto: <%= project.projectName || project.fullName || project.projectCode %> · Control de compromisos contractuales y cuentas por pagar
              <% } else { %>
                Informe consolidado de compromisos contractuales y cuentas por pagar
              <% } %>
            </p>
          </td>
          <td class="header-meta" style="width: 30%;">
            <div>
              <span class="code-badge"><%= isProjectMode ? (project.projectCode || "PROYECTO") : "CONSOLIDADO" %></span>
            </div>
            <span class="emission-date">Emisión: <%= emissionDateStr %></span>
          </td>
        </tr>
      </table>

      <div class="accent-bar">
        <span class="seg-green"></span>
        <span class="seg-orange"></span>
      </div>
    </header>

    <!-- 2. FICHA TÉCNICA DEL PROYECTO (Si es modo proyecto) -->
    <% if (isProjectMode && project) { %>
      <section class="section avoid-break">
        <table class="section-header-table">
          <tr>
            <td><h2 class="section-title">1. Ficha del Proyecto</h2></td>
          </tr>
        </table>

        <div class="ficha-card">
          <table class="ficha-table">
            <tr>
              <td style="width: 33.33%; padding-right: 10px;">
                <span class="field-label">Proyecto</span>
                <div class="field-value"><%= project.projectName || project.fullName || project.projectCode %></div>
              </td>
              <td style="width: 33.33%; padding-right: 10px;">
                <span class="field-label">Empresa Contratante</span>
                <div class="field-value-sm"><%= companyName %></div>
              </td>
              <td style="width: 33.34%;">
                <span class="field-label">Anticipo Otorgado / Pendiente</span>
                <div class="field-value-sm">
                  <%= fmt(summary.advancePayment) %> (Pendiente: <%= fmt(summary.pendingAdvance) %>)
                </div>
              </td>
            </tr>
          </table>
        </div>
      </section>
    <% } %>

    <!-- 3. RESUMEN DE OBLIGACIONES Y PAGOS -->
    <section class="section avoid-break">
      <table class="section-header-table">
        <tr>
          <td style="width: 65%;">
            <h2 class="section-title">
              <%= isProjectMode ? "2. Resumen de Deuda y Pagos" : "1. Resumen Global de Obligaciones" %>
            </h2>
          </td>
          <td class="section-subtitle" style="width: 35%;">
            <span class="pill-badge">Valores expresados en USD</span>
          </td>
        </tr>
      </table>

      <!-- STRIP DE TARJETAS KPI -->
      <table class="kpi-table">
        <tr>
          <!-- Deuda Total -->
          <td style="width: 33.33%; padding-right: 6px;">
            <div class="kpi-card kpi-card-neutral">
              <span class="kpi-title" style="color: #4e5558;">Deuda Total Comprometida</span>
              <div class="kpi-number" style="color: #111416;"><%= fmt(summary.totalDebt) %></div>
              <p class="kpi-foot" style="color: #4e5558;">
                <%= isProjectMode ? (summary.totalItems + " obligaciones registradas") : (totalProjectsCount + " proyectos con deuda") %>
              </p>
            </div>
          </td>

          <!-- Cancelado -->
          <td style="width: 33.33%; padding: 0 3px;">
            <div class="kpi-card kpi-card-paid">
              <span class="kpi-title" style="color: #236343;">Total Cancelado</span>
              <div class="kpi-number" style="color: #1b5e20;">
                <%= fmt(summary.totalPaid) %>
                <span class="kpi-unit" style="color: #236343;">(<%= summary.paidPct %>%)</span>
              </div>
              <p class="kpi-foot" style="color: #2e7d32;">Desembolsos efectivos liquidados</p>
            </div>
          </td>

          <!-- Por Pagar -->
          <td style="width: 33.33%; padding-left: 6px;">
            <div class="kpi-card <%= summary.totalPending > 0 ? 'kpi-card-pending-alert' : 'kpi-card-pending-ok' %>">
              <span class="kpi-title" style="color: <%= summary.totalPending > 0 ? '#c85454' : '#236343' %>;">
                Total Por Pagar
              </span>
              <div class="kpi-number" style="color: <%= summary.totalPending > 0 ? '#c85454' : '#236343' %>;">
                <%= fmt(summary.totalPending) %>
                <span class="kpi-unit" style="color: #4e5558;">(<%= summary.pendingPct %>%)</span>
              </div>
              <p class="kpi-foot" style="color: <%= summary.totalPending > 0 ? '#a84730' : '#2e7d32' %>;">
                <%= summary.totalPending > 0 ? "Obligaciones pendientes de pago" : "Sin obligaciones pendientes" %>
              </p>
            </div>
          </td>
        </tr>
      </table>

      <!-- BARRA DE LIQUIDACIÓN DE DEUDA -->
      <div class="progress-bar-card">
        <table class="progress-legend-table">
          <tr>
            <td style="width: 50%; color: #4e5558;">Proporción de Liquidación de Deuda</td>
            <td style="width: 50%; text-align: right;">
              <span style="margin-right: 12px; color: #236343;">
                ● Cancelado (<%= summary.paidPct %>%)
              </span>
              <span style="color: #c85454;">
                ● Por Pagar (<%= summary.pendingPct %>%)
              </span>
            </td>
          </tr>
        </table>
        <div class="progress-track">
          <div class="progress-fill-paid" style="width: <%= summary.paidPct %>%;"></div>
          <div class="progress-fill-pending" style="width: <%= summary.pendingPct %>%;"></div>
        </div>
      </div>
    </section>

    <!-- 4. TABLA DETALLADA -->
    <section class="section">
      <table class="section-header-table avoid-break">
        <tr>
          <td style="width: 70%;">
            <h2 class="section-title">
              <%= isProjectMode ? "3. Detalle de Obligaciones y Cuentas por Pagar" : "2. Detalle de Cuentas por Pagar por Proyecto" %>
            </h2>
          </td>
          <td class="section-subtitle" style="width: 30%;">
            <%= isProjectMode ? (items.length + " registros") : (projects.length + " proyectos") %>
          </td>
        </tr>
      </table>

      <div class="table-wrapper">
        <% if (isProjectMode) { %>
          <!-- MODO PROYECTO: LISTA DE OBLIGACIONES -->
          <table class="report-table">
            <colgroup>
              <col style="width: 36%;" />
              <col style="width: 16%;" />
              <col style="width: 16%;" />
              <col style="width: 16%;" />
              <col style="width: 16%;" />
            </colgroup>
            <thead>
              <tr>
                <th>Proveedor / Concepto</th>
                <th class="text-center" style="white-space: nowrap;">Monto Original</th>
                <th class="text-center" style="white-space: nowrap;">Cancelado</th>
                <th class="text-center" style="white-space: nowrap;">Por Pagar</th>
                <th class="text-center" style="white-space: nowrap;">Estado</th>
              </tr>
            </thead>
            <tbody>
              <% items.forEach(function(item) { %>
                <tr>
                  <td>
                    <span style="font-weight: 700; color: #111416; display: block;">
                      <%= item.supplierName || item.description %>
                    </span>
                    <% if (item.supplierName && item.description) { %>
                      <span style="font-size: 7.5pt; color: #4e5558; display: block; margin-top: 1px;">
                        <%= item.description %>
                      </span>
                    <% } %>
                  </td>
                  <td class="text-center" style="font-weight: 500; color: #111416; white-space: nowrap;">
                    <%= fmt(item.originalAmountUsd) %>
                  </td>
                  <td class="text-center" style="font-weight: 900; color: #1b5e20; white-space: nowrap;">
                    <%= fmt(item.paidAmountUsd) %>
                  </td>
                  <td class="text-center" style="font-weight: 900; color: <%= item.pendingAmountUsd > 0 ? '#c85454' : '#4e5558' %>; white-space: nowrap;">
                    <%= fmt(item.pendingAmountUsd) %>
                  </td>
                  <td class="text-center" style="white-space: nowrap;">
                    <%
                      var badgeCls = 'badge-pendiente';
                      if (item.status === 'PAGADO') badgeCls = 'badge-pagado';
                      else if (item.status === 'PARCIAL') badgeCls = 'badge-parcial';
                    %>
                    <span class="badge-status <%= badgeCls %>"><%= item.status %></span>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } else { %>
          <!-- MODO GLOBAL: LISTA DE PROYECTOS -->
          <table class="report-table">
            <colgroup>
              <col style="width: 24%;" />
              <col style="width: 24%;" />
              <col style="width: 13%;" />
              <col style="width: 13%;" />
              <col style="width: 13%;" />
              <col style="width: 13%;" />
            </colgroup>
            <thead>
              <tr>
                <th>Proyecto</th>
                <th>Empresa</th>
                <th class="text-center" style="white-space: nowrap;">Deuda Total</th>
                <th class="text-center" style="white-space: nowrap;">Cancelado</th>
                <th class="text-center" style="white-space: nowrap;">Por Pagar</th>
                <th class="text-center" style="white-space: nowrap;">% Saldado</th>
              </tr>
            </thead>
            <tbody>
              <% projects.forEach(function(p) { %>
                <%
                  var debt = p.summary ? p.summary.totalDebt : 0;
                  var paid = p.summary ? p.summary.totalPaid : 0;
                  var pending = p.summary ? p.summary.totalPending : 0;
                  var pct = debt > 0 ? Math.round((paid / debt) * 100) : 0;
                %>
                <tr>
                  <td>
                    <span style="font-weight: 700; color: #111416; display: block;"><%= p.code %></span>
                    <span style="font-size: 7.5pt; color: #4e5558; display: block; margin-top: 1px;"><%= p.fullName %></span>
                  </td>
                  <td style="color: #4e5558; font-weight: 500;">
                    <%= (p.company && p.company.name) ? p.company.name : "Sin empresa" %>
                  </td>
                  <td class="text-center" style="font-weight: 500; color: #111416; white-space: nowrap;">
                    <%= fmt(debt) %>
                  </td>
                  <td class="text-center" style="font-weight: 900; color: #1b5e20; white-space: nowrap;">
                    <%= fmt(paid) %>
                  </td>
                  <td class="text-center" style="font-weight: 900; color: <%= pending > 0 ? '#c85454' : '#4e5558' %>; white-space: nowrap;">
                    <%= fmt(pending) %>
                  </td>
                  <td class="text-center" style="font-weight: 700; white-space: nowrap;">
                    <span class="badge-status <%= pct >= 100 ? 'badge-pagado' : (pct > 0 ? 'badge-parcial' : 'badge-pendiente') %>">
                      <%= pct %>%
                    </span>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>

  </div>
</body>
</html>
