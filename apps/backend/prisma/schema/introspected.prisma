model ErpModuleMembership {
  id           String   @id
  userId       String
  module       String
  moduleUserId String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  users        ErpUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([module])
  @@map("erp_module_memberships")
}

model PmAuditLog {
  id         String       @id
  actorId    String
  externalId String?
  module     String       @default("PROJECT_MANAGEMENT")
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  route      String?
  createdAt  DateTime     @default(now())
  pm_users   PmModuleUser @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([module, actorId, createdAt(sort: Desc)])
  @@map("pm_audit_log")
}

model PmPermission {
  id                  String            @id
  code                String            @unique
  description         String?
  pm_role_permissions PmRolePermission[]

  @@map("pm_permissions")
}

model PmRolePermission {
  roleId         String
  permissionId   String
  pm_permissions PmPermission @relation(fields: [permissionId], references: [id])
  pm_roles       PmRole       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@map("pm_role_permissions")
}

model PmUserRole {
  userId   String
  roleId   String
  pm_roles PmRole       @relation(fields: [roleId], references: [id])
  pm_users PmModuleUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("pm_user_roles")
}

enum PmProjectStatus {
  IN_PROGRESS
  ON_HOLD
  RESCHEDULED
  DELAYED
  PLANNED
  COMPLETED
  CANCELLED
}

enum PmValuationStatus {
  POR_VALUAR
  POR_FACTURAR
  FACTURADO
}
