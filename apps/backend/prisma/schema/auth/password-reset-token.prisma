model ErpPasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      ErpUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("erp_password_reset_tokens")
}
