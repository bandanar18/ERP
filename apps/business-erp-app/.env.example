# =====================================================
# BUSINESS ERP APP - VARIABLES DE ENTORNO
# Copiar este archivo a .env y ajustar los valores.
# Las variables EXPO_PUBLIC_* quedan embebidas en el bundle JS.
# =====================================================

# URL base del backend del Business ERP.
#  - Web / iOS simulator / emulador Android con adb reverse: http://localhost:3000
#  - Android emulator (sin adb reverse): http://10.0.2.2:3000
#  - Dispositivo físico: http://<IP-de-tu-máquina-en-la-red-local>:3000
EXPO_PUBLIC_API_URL="http://localhost:3000"
